<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/queue_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="6dp">

    <View
        android:id="@+id/queue_item_accent_border"
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="8dp"
        android:background="@color/jellyfin_accent"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="120dp"
        android:layout_height="68dp">

        <ImageView
            android:id="@+id/queue_item_thumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#222222"
            android:scaleType="centerCrop"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/queue_item_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|bottom"
            android:layout_margin="4dp"
            android:background="@color/queue_item_duration_background"
            android:paddingHorizontal="4dp"
            android:paddingVertical="1dp"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            tools:text="1:23:45" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/queue_item_now_playing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/queue_item_now_playing"
            android:textColor="@color/jellyfin_accent"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/queue_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="?android:textColorPrimary"
            android:textSize="13sp"
            tools:text="Video Title Goes Here" />

        <TextView
            android:id="@+id/queue_item_series"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?android:textColorSecondary"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="Series Name" />
    </LinearLayout>
</LinearLayout>
